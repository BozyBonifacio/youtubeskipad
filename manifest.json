{
  "manifest_version": 3,
  "name": "YouTube Auto-Skip",
  "version": "1.1.0",
  "description": "Clicks YouTube's visible Skip Ad button using browser-level mouse input.",
  "permissions": ["storage", "debugger"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Auto-Skip",
    "default_popup": "popup.html"
  }
}
