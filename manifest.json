{
  "manifest_version": 3,
  "name": "YouTube Auto-Skip",
  "version": "1.0.3",
  "description": "Attempts to skip YouTube ads only after the Skip Ad button becomes available.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Auto-Skip",
    "default_popup": "popup.html"
  }
}
