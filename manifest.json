{
  "manifest_version": 3,
  "name": "YouTube Auto-Skip",
  "version": "1.0.0",
  "description": "Automatically clicks YouTube's Skip Ad button when available.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Auto-Skip",
    "default_popup": "popup.html"
  }
}
